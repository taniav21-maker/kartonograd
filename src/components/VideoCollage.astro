---
interface VideoItem {
  id: string;
  aspect: 'horizontal' | 'vertical';
  label?: string;
}

interface Props {
  title?: string;
  subtitle?: string;
  videos?: VideoItem[];
}

const { 
  title = "Собрали вместе с детьми",
  subtitle = "Блогеры показывают, как это работает",
  videos = [
    { id: "loveshopping", aspect: "horizontal", label: "loveshopping" },
    { id: "OksanaBulat", aspect: "horizontal", label: "OksanaBulat" },
    { id: "lv", aspect: "vertical", label: "" },
    { id: "mama_tanya", aspect: "vertical", label: "mama_tanya" },
    { id: "kids_play", aspect: "vertical", label: "kids_play" },
    { id: "family_fun", aspect: "vertical", label: "family_fun" }
  ]
} = Astro.props;
---

<section id="video-collage" class="py-12 md:py-20 px-6 bg-craft-white">
  <div class="container mx-auto">
    <div class="text-center mb-10 md:mb-14">
      <h2 class="text-3xl md:text-4xl font-fredoka font-bold text-craft-dark mb-4">{title}</h2>
      <p class="text-gray-600 text-lg md:text-xl max-w-2xl mx-auto">{subtitle}</p>
    </div>

    {/* Видео-коллаж */}
    <div class="space-y-6 md:space-y-8">
      {/* Верхний ряд - горизонтальные видео */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 md:gap-6">
        {videos.filter(v => v.aspect === 'horizontal').map((video, index) => (
          <div 
            class={`${index === 0 ? 'lg:col-span-5' : 'lg:col-span-7'} aspect-video`}
            key={video.id}
          >
<div class="bg-gray-200 h-full rounded-xl overflow-hidden relative flex flex-col items-center justify-center p-4 md:p-6" aria-label={`Видео-обзор блогера ${video.label || 'Картонограда'}`}>
               <div class="absolute inset-0 bg-gradient-to-br from-gray-200/80 to-gray-300/60"></div>
               <button class="relative z-10 group">
                <div class="w-14 h-14 md:w-16 md:h-16 bg-accent-orange rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-7 h-7 md:w-8 md:h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
                {video.label && (
                  <p class="text-center text-craft-dark font-medium mt-3 md:mt-4 text-sm md:text-base">{video.label}</p>
                )}
              </button>
            </div>
          </div>
        ))}
      </div>

      {/* Нижний ряд - вертикальные видео */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-4">
        {videos.filter(v => v.aspect === 'vertical').map((video) => (
          <div 
            class="aspect-[9/16] sm:aspect-auto" 
            key={video.id}
          >
            <div class="bg-gray-200 h-full rounded-xl overflow-hidden relative flex flex-col items-center justify-center p-4">
              <div class="absolute inset-0 bg-gradient-to-br from-gray-200/80 to-gray-300/60"></div>
              <button class="relative z-10 group">
                <div class="w-12 h-12 md:w-14 md:h-14 bg-accent-orange rounded-full flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform duration-300">
                  <svg class="w-6 h-6 md:w-7 md:h-7 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                </div>
                {video.label && (
                  <p class="text-center text-craft-dark font-medium mt-3 text-sm">{video.label}</p>
                )}
              </button>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Строка для блогеров */}
    <div class="text-center mt-8 md:mt-12">
      <p class="text-gray-600 md:text-lg">
        Вы блогер? 
        <a 
          href="#" 
          class="ml-2 text-accent-blue font-semibold hover:text-blue-700 hover:underline transition duration-300"
        >
          Написать нам →
        </a>
      </p>
    </div>
  </div>
</section>