

---
import StickyButton from '../components/StickyButton.astro';
---

<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Картоноград — картонный конструктор для детей</title>
    <meta name="description" content="Собирайте фигурки из картона без клея и ножниц. От 1 000 ₽. Доставка по России.">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="theme-color" content="#FB5C20">
  </head>
  <body>
    <header class="bg-craft-white border-b border-gray-200 py-4 px-6">
      <nav class="container mx-auto flex justify-between items-center">
        <div class="text-2xl font-fredoka font-bold text-craft-dark">Картоноград</div>
        <div class="hidden md:flex space-x-6 items-center">
          <a href="#hero" class="text-craft-dark hover:text-accent-orange transition">Главная</a>
          <a href="#catalog" class="text-craft-dark hover:text-accent-orange transition">Наборы</a>
          <a href="#collection" class="text-craft-dark hover:text-accent-orange transition">Коллекция</a>
          <a href="#faq" class="text-craft-dark hover:text-accent-orange transition">Вопросы</a>
          <a href="#" class="text-craft-dark hover:text-accent-orange transition">Контакты</a>
          <div class="ml-4">
            <div class="relative">
              <button id="cart-icon-trigger" class="cart-icon-button text-craft-dark hover:text-accent-orange transition cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span id="cart-badge" class="hidden absolute -top-2 -right-2 bg-accent-orange text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
              </button>
            </div>
          </div>
        </div>
        <div class="md:hidden flex items-center">
          <div class="mr-4">
            <div class="relative">
              <button id="cart-icon-trigger-mobile" class="cart-icon-button text-craft-dark hover:text-accent-orange transition cursor-pointer">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span id="cart-badge-mobile" class="hidden absolute -top-2 -right-2 bg-accent-orange text-white text-xs rounded-full w-5 h-5 flex items-center justify-center">0</span>
              </button>
            </div>
          </div>
          <button class="text-craft-dark">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </nav>
    </header>
    
    <main>
      <slot />
    </main>
    
    <footer class="bg-craft-dark text-craft-white py-8 px-6 mt-12">
      <div class="container mx-auto">
        <div class="flex flex-col md:flex-row justify-between items-center">
          <div class="mb-6 md:mb-0">
            <div class="text-2xl font-fredoka font-bold mb-2">Картоноград</div>
            <p class="text-gray-300">© 2024 Картонный конструктор для детей</p>
          </div>
          <div class="text-center md:text-right">
            <p class="mb-2">Доставка СДЭК по России и ЕАЭС</p>
            <p class="text-gray-300">support@kartonograd.ru</p>
          </div>
        </div>
      </div>
    </footer>
    
    <!-- Модальное окно корзины -->
    <div id="cart-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl p-6 max-w-2xl w-full max-h-[80vh] overflow-auto relative">
        <button class="close-modal absolute top-4 right-4 text-gray-500 hover:text-gray-700 text-2xl z-10">&times;</button>
        <h3 class="text-2xl md:text-3xl font-fredoka font-bold text-craft-dark mb-6">Корзина</h3>
        <div id="cart-items" class="mb-6"><!-- Сюда JS будет вставлять товары --></div>
        <div id="cart-promo" class="mb-4">
          <div class="text-sm text-gray-500 mb-2">Доступные промокоды: KARTON10 (10% скидка)</div>
          <div class="flex flex-col sm:flex-row gap-2 mb-4">
            <input id="promo-input" type="text" placeholder="Введите промокод" class="flex-1 border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent-blue">
            <button id="apply-promo" class="w-full sm:w-auto bg-accent-blue text-white font-semibold px-6 py-3 rounded-xl hover:bg-blue-700 transition duration-300">Применить</button>
          </div>
          <div id="promo-message" class="text-sm hidden"></div>
        </div>
        <div id="cart-total" class="font-bold text-xl border-t pt-4 mb-6">Итого: 0 ₽</div>
        <button id="checkout-btn" class="w-full bg-accent-orange text-white py-4 rounded-xl text-lg font-semibold hover:bg-orange-600 transition duration-300">Оформить заказ</button>
      </div>
    </div>
    
    <StickyButton />
    
    <script src="/src/scripts/cart.js" defer></script>
  </body>
</html>