---
import Layout from '../layouts/Layout.astro';
import PromoBanner from '../components/PromoBanner.astro';
import Hero from '../components/Hero.astro';
import StepBlock from '../components/StepBlock.astro';
import VideoCollage from '../components/VideoCollage.astro';
import Catalog from '../components/Catalog.astro';
import WhatsInTheBox from '../components/WhatsInTheBox.astro';
import Collection from '../components/Collection.astro';
import FAQ from '../components/FAQ.astro';
import Final from '../components/Final.astro';
import Banners from '../components/Banners.astro';
import StickyButton from '../components/StickyButton.astro';
import '../styles/global.css';
---

<PromoBanner />

<Layout>
  <Hero />
  
  <Catalog />
  
  <WhatsInTheBox />
  
  <Collection />
  
  <FAQ />
  
  <Final />
  
  <Banners />
  
  <section id="features" class="py-12 md:py-20 px-6 bg-gray-50">
    <div class="container mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl md:text-4xl font-fredoka font-bold text-craft-dark mb-4">Почему Картоноград?</h2>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="bg-white p-8 rounded-2xl shadow-md text-center">
          <div class="w-16 h-16 bg-accent-yellow text-craft-dark rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🧠</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Развитие</h3>
          <p class="text-gray-600">Развивает мелкую моторику, пространственное мышление и креативность</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-md text-center">
          <div class="w-16 h-16 bg-accent-blue text-craft-white rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🌿</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Экология</h3>
          <p class="text-gray-600">100% перерабатываемый картон, безопасные краски на водной основе</p>
        </div>
        
        <div class="bg-white p-8 rounded-2xl shadow-md text-center">
          <div class="w-16 h-16 bg-accent-orange text-craft-white rounded-full flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">⏱️</span>
          </div>
          <h3 class="text-xl font-bold mb-3">Простота</h3>
          <p class="text-gray-600">Сборка за 15-30 минут, не нужно клея, ножниц или дополнительных инструментов</p>
        </div>
      </div>
    </div>
  </section>
</Layout>